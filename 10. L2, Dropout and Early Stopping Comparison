import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt

X = np.random.rand(500,10)
y = (np.sum(X,axis=1)>5).astype(int)

def model(reg=None, drop=False):
    m = tf.keras.Sequential()
    m.add(tf.keras.layers.Dense(32, activation="relu",
          kernel_regularizer=reg, input_shape=(10,)))
    if drop:
        m.add(tf.keras.layers.Dropout(0.5))
    m.add(tf.keras.layers.Dense(1, activation="sigmoid"))
    m.compile("adam", "binary_crossentropy", metrics=["accuracy"])
    return m

m1 = model()
m2 = model(tf.keras.regularizers.l2(0.01))
m3 = model(drop=True)

h1 = m1.fit(X,y,epochs=30,validation_split=.2,verbose=0)
h2 = m2.fit(X,y,epochs=30,validation_split=.2,verbose=0)
h3 = m3.fit(X,y,epochs=30,validation_split=.2,verbose=0,
            callbacks=[tf.keras.callbacks.EarlyStopping(patience=3)])

plt.plot(h1.history["val_loss"], label="Normal")
plt.plot(h2.history["val_loss"], label="L2")
plt.plot(h3.history["val_loss"], label="Dropout + Early Stop")
plt.legend()
plt.xlabel("Epoch")
plt.ylabel("Validation Loss")
plt.show()
